library(tidyverse)
library(lubridate)
library(rmarkdown)
library(rmarkdown)
library(performance)
library(randomForest)
library(ggpmisc)
library(RColorBrewer)
library(seacarb)
library(viridis)
library(patchwork)
library(Metrics)
rm(list=ls())
DIC_bottle_data <- read.csv("derived-data/DIC_bottle_data.csv")
DOC_bottle_data <- read.csv("derived-data/DOC_bottle_data.csv")
sensor_data <- read.csv("derived-data/sensor_data.csv")
if("DIC" %in% colnames(sensor_data))
{sensor_data=select(sensor_data, -DIC, -DOC)}
clean_dic_data <- DIC_bottle_data %>%
filter(!is.na(DIC) & !is.na(pH) & !is.na(T) & !is.na(S) & !is.na(DO))
DIC_model <- lm(log10(DIC) ~ log10(pH) + log10(T) + log10(S) + log10(DO) ,
data = clean_dic_data)
summary(DIC_model)
plot(DIC_model)
#model performance
DIC_predicted <- predict(DIC_model, clean_dic_data)
a <- Metrics::rmse(10^DIC_model$fitted.values, clean_dic_data$DIC)
b <- summary(DIC_model)$r.squared
paste("DIC model statistics"," R2","=",round(b,digit=2), "RMSE","=",round(a,digit=0))
plot_DIC <- as.data.frame(10^DIC_model$fitted.values)
plot_DIC$DIC_meas <- clean_dic_data$DIC
plot_DIC$date <- month(clean_dic_data$datetime)
p_model_DIC<-ggplot(plot_DIC,aes(x=10^DIC_model$fitted.values,y=DIC_meas, color=date))+
geom_point(size=3) +
geom_abline(slope = 1, intercept = 0, linetype = "dashed", color = "black", size = 1)+
labs(x = expression(paste("Measured DIC"," (",mu,"mol"," L"^-1,")")),
y = expression(paste("Predicted DIC"," (",mu,"mol"," L"^-1,")")),
color="",
tag = "")+
stat_smooth(method = "lm",se = FALSE)+
theme_bw()+
theme(aspect.ratio = 1,
legend.text = element_text(size = 12),
legend.title = element_text(size = 12),
plot.title = element_text(hjust = 0.5),
axis.line = element_line(colour = "black"),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
axis.text = element_text(size = 12),
axis.title =  element_text(size = 12),
axis.title.x = element_text(size = 12),
axis.text.x = element_text(size = 12))
p_model_DIC
View(DIC_bottle_data)
