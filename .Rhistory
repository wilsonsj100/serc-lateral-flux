## Function to read in sontek You can rinse and repeat w other instruments, just change cols
read_sontek <- function(path) {
readr::read_delim(
file = path,
skip = 1,
show_col_types = FALSE
) %>%
janitor::clean_names() %>%  # converts to lowercase + snake_case
dplyr::slice(3:dplyr::n()) %>%
dplyr::mutate(
timestamp = parsedate::parse_date(.data$timestamp),
datetime_raw = lubridate::force_tz(.data$timestamp, tzone = common_tz)
) %>%
# Optionally coerce known columns to double
dplyr::mutate(across(
c(water_depth, flowrate, cross_area, mean_velocity, total_volume),
as.numeric
))
}
