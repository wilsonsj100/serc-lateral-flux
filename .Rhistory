theme_classic() +
labs(x = " ", y = "NPOC (mg/L)", title = "Samples: NPOC") +
theme(legend.position = "none") +
scale_x_discrete(drop = TRUE) +
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1))
print(viz_c_plot)
viz_n_plot <-  ggplot(dat_flagged_id, aes(x = sample_name, y = tdn_raw, fill = Zone)) +
geom_bar(stat = "identity", position = position_dodge2(preserve = "single")) +
scale_fill_manual(values = c("#419973", "#25ABE6" )) +
theme_classic() +
labs(x = " ", y = "TN (mg/L)", title = "Samples: TN") +
theme(legend.position = "none")  +
scale_x_discrete(drop = TRUE) +
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1))
print(viz_c_plot)
print(viz_n_plot)
viz_n_plot <-  ggplot(dat_flagged_id, aes(x = sample_name, y = tdn_raw, fill = Sample_Type)) +
geom_bar(stat = "identity", position = position_dodge2(preserve = "single")) +
scale_fill_manual(values = c("#419973", "#25ABE6" )) +
theme_classic() +
labs(x = " ", y = "TN (mg/L)", title = "Samples: TN") +
theme(legend.position = "none")  +
scale_x_discrete(drop = TRUE) +
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1))
print(viz_n_plot)
#convert npoc and tdn from mg/L to uMoles/L
dat_flagged_id <- dat_flagged_id %>%
mutate(
npoc_uM = (((as.numeric(dat_flagged_id$npoc_raw))/Con1)/mw_c)*Con2,
tdn_uM = (((as.numeric(dat_flagged_id$tdn_raw))/Con1)/mw_n)*Con2
)
