read_sontek <- function(path){
cols = c("water_depth", "flowrate", "cross_area", "mean_velocity", "total_volume"  ) ## CHANGE ME
read_delim(path, skip = 1) %>%
clean_names() %>%
slice(3:n()) %>% ## remove dead header rows
#slice(1:100) %>%  ## use this if something breaks, it'll make reading in MUCH faster
col_types = readr::cols(
sontek_id         = readr::col_character(),
timestamp         = readr::col_character(),
record            = readr::col_character(),
flowrate          = readr::col_double(),
stage             = readr::col_double(),
mean_velocity     = readr::col_double(),
total_volume      = readr::col_double(),
water_depth       = readr::col_double(),
index_velocity    = readr::col_double(),
cross_area        = readr::col_double(),
water_temperature = readr::col_double(),
system_status     = readr::col_character(),
velocity_x_zxc    = readr::col_double(),
velocity_x_zzc    = readr::col_double(),
velocity_x_zxl    = readr::col_double(),
velocity_x_zxr    = readr::col_double(),
batt_vol_sontek   = readr::col_double(),
pitch_angle       = readr::col_double(),
roll_angle        = readr::col_double(),
perc_submergance  = readr::col_double(),
range_water_surface= readr::col_double(),
adj_water_depth   = readr::col_double(),
tot_vo_lpos       = readr::col_double(),
tot_vo_lneg       = readr::col_double(),
ecell             = readr::col_double(),
snr1              = readr::col_double(),
snr2              = readr::col_double(),
snr3              = readr::col_double(),
snr4              = readr::col_double(),
.default          = readr::col_guess()
)} #%>% ## from janitor pkg, make column names nice
