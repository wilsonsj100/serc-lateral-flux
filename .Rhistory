theme(legend.position = "none")
print(viz_ic_dotplot)
viz_ic_dotplot <- ggplot(isco_only, aes(x = num_id, y = ic_mgL_mean, color = Sample_Type)) +
geom_point(stat = "identity") +
geom_errorbar(aes(
ymin = ic_mgL_mean - ic_mgL_sd,
ymax = ic_mgL_mean + ic_mgL_sd
), width = 0.1) +
geom_line()+
scale_color_manual(values = c("deepskyblue", "seagreen", "navy"))+
facet_grid( ~Sample_Location, scales="free_x") +
theme_classic() +
labs(x = "Time Point", y = "IC (mg/L)", title = "Samples: DIC") +
theme(legend.position = "none")
print(viz_ic_dotplot)
dat_summary <- dat_flagged_id %>%
group_by(sample_name_1) %>%
summarise(
ic_mgL_mean = mean(ic_raw, na.rm = TRUE),
ic_mgL_sd = sd(ic_raw, na.rm = TRUE),
ic_uM_mean = mean(ic_uM, na.rm = TRUE),
ic_uM_sd = sd(ic_uM, na.rm = TRUE),
ic_flag = first(ic_flag),
Sample_Type = first(Sample_Type),
Sample_Location = first(Sample_Location),
Time_Point = first(Time_Point))
head(dat_summary)
#let's remove the pw and sw data and just plot the isco samples through time and remove paired samples
isco_only <- dat_summary %>%
filter(Sample_Type == "SW") %>%
filter(!str_detect(sample_name_1, "pair"))
viz_ic_dotplot <- ggplot(isco_only, aes(x = Time_Point, y = ic_mgL_mean, color = Sample_Type)) +
geom_point(stat = "identity") +
geom_errorbar(aes(
ymin = ic_mgL_mean - ic_mgL_sd,
ymax = ic_mgL_mean + ic_mgL_sd
), width = 0.1) +
geom_line()+
scale_color_manual(values = c("deepskyblue", "seagreen", "navy"))+
facet_grid( ~Sample_Location, scales="free_x") +
theme_classic() +
labs(x = "Time Point", y = "IC (mg/L)", title = "Samples: DIC") +
theme(legend.position = "none")
print(viz_ic_dotplot)
viz_ic_dotplot
