DIC_DOC <- merge(DOC_data1, DIC_data1, by = "Sample_ID", all = TRUE)
##Add missing metadata
DIC_DOC <- DIC_DOC %>%
mutate(Date = case_when(
str_detect(Sample_ID, "20240209") ~ "2024-02-09",
str_detect(Sample_ID, "20240215") ~ "2024-02-15",
TRUE ~ Date
))
##Add missing metadata
DIC_DOC <- DIC_DOC %>%
mutate(Date = case_when(
str_detect(Sample_ID, "20240209") ~ as.Date("2024-02-09"),
str_detect(Sample_ID, "20240215") ~ as.Date("2024-02-15"),
TRUE ~ Date
))
##Add missing metadata
DIC_DOC <- DIC_DOC %>%
mutate(Date = case_when(
str_detect(Sample_ID, "20240209") ~ as.Date("2024-02-09"),
str_detect(Sample_ID, "20240215") ~ as.Date("2024-02-15"),
TRUE ~ Date
)) %>%
mutate(Sample_ID = gsub("LATT_GCW_T1_20240715_1100", "LATT_GCW_T1", Sample_ID)) %>%
mutate(Sample_ID = gsub("LATT_GCW_T2_20240715_1200", "LATT_GCW_T2", Sample_ID))
##Add missing metadata
DIC_DOC <- DIC_DOC %>%
mutate(Date = case_when(
str_detect(Sample_ID, "20240209") ~ as.Date("2024-02-09"),
str_detect(Sample_ID, "20240215") ~ as.Date("2024-02-15"),
TRUE ~ Date)) %>%
mutate(Sample_Type = case_when(
str_detect(Sample_ID, "FLUME_20240215_SW_1500") ~ "SW",
str_detect(Sample_ID, "FLUME_20240215_FW_1") ~ "FW",
TRUE ~ Sample_Type)) %>%
mutate(Sample_ID = gsub("LATT_GCW_T1_20240715_1100", "LATT_GCW_T1", Sample_ID)) %>%
mutate(Sample_ID = gsub("LATT_GCW_T2_20240715_1200", "LATT_GCW_T2", Sample_ID))
#write out all the DIC and DOC sample data
write.csv(DIC_DOC, "TidalSurvey_DOC_DIC.csv", row.names = FALSE)
library(dplyr)
library(ggplot2)
library(ggpubr)
library(stringr)
library(readxl)
library(tidyr)
library(tibble)
library(lubridate)
files <- list.files(path = "../DOC_data/Processed Data", pattern = "\\.csv$", full.names = TRUE)
data_list <- lapply(files, function(f) {
df <- read.csv(f, stringsAsFactors = FALSE)  # avoids factors
# df$Site <- as.character(df$Site)             # ensures character
return(df)
})
# Combine all files
DOC_data <- bind_rows(data_list)
#remove the first unneeded column
DOC_data <- DOC_data[, -which(names(DOC_data) == "X")]
colnames(DOC_data)
DOC_data1 <- DOC_data %>%
mutate(Date = ymd(Date)) %>%
select(Project, Date, Time, Sample_Location, npoc_mgL, npoc_uM, npoc_flag, tdn_mgL, tdn_uM, tdn_flag)
files <- list.files(path = "../DIC_data/Processed Data", pattern = "\\.csv$", full.names = TRUE)
data_list <- lapply(files, function(f) {
df <- read.csv(f, stringsAsFactors = FALSE)  # avoids factors
# df$Site <- as.character(df$Site)             # ensures character
return(df)
})
# Combine all files
DIC_data <- bind_rows(data_list)
#remove the first unneeded column
DIC_data <- DIC_data[, -which(names(DIC_data) == "X")]
DIC_data1 <- DIC_data %>%
mutate(Date = ymd(Date)) %>%
group_by(Project, Date, Time, Sample_Location) %>%
summarise(
ic_mgL_sd = sd(ic_mgL, na.rm = TRUE),
ic_uM_sd = sd(ic_uM, na.rm = TRUE),
ic_mgL = mean(ic_mgL, na.rm = TRUE),
ic_uM = mean(ic_uM, na.rm = TRUE),
YSI_Temp_C = mean(YSI_Temp_C, na.rm = TRUE),
YSI_Sal_ppt = mean(YSI_Sal_ppt, na.rm = TRUE),
# Take the first value of all OTHER columns not mentioned above
across(-c(ic_mgL, ic_mgL_sd, ic_uM, ic_uM_sd, YSI_Temp_C, YSI_Sal_ppt, Replicate), first),
.groups = "drop"
) %>%
select(Project, Date, Time, Sample_Location, ic_mgL, ic_mgL_sd, ic_uM, ic_uM_sd, ic_flag)
files <- list.files(path = "TA_data", pattern = "\\.csv$", full.names = TRUE)
data_list <- lapply(files, function(f) {
df <- read.csv(f, stringsAsFactors = FALSE)  # avoids factors
# df$Site <- as.character(df$Site)             # ensures character
return(df)
})
# Combine all files
TA_data <- bind_rows(data_list)
#remove the first unneeded column
TA_data <- TA_data[, -which(names(TA_data) == "X")]
##Match DIC/DOC columns names
TA_data1 <- TA_data %>%
mutate(Project = "FATE",
TA_mmolL = Alk_GP_avg/1000,
Date = mdy(date),
Time = substr(time, 1, 5),
location = gsub("Marsh_weir", "Flume", location)) %>%
rename(Sample_Location = location) %>%
select(Project, Date, Time, Sample_Location, sample_id, TA_mmolL)
files <- list.files(path = "../TA_data", pattern = "\\.csv$", full.names = TRUE)
data_list <- lapply(files, function(f) {
df <- read.csv(f, stringsAsFactors = FALSE)  # avoids factors
# df$Site <- as.character(df$Site)             # ensures character
return(df)
})
# Combine all files
TA_data <- bind_rows(data_list)
#remove the first unneeded column
TA_data <- TA_data[, -which(names(TA_data) == "X")]
##Match DIC/DOC columns names
TA_data1 <- TA_data %>%
mutate(Project = "FATE",
TA_mmolL = Alk_GP_avg/1000,
Date = mdy(date),
Time = substr(time, 1, 5),
location = gsub("Marsh_weir", "Flume", location)) %>%
rename(Sample_Location = location) %>%
select(Project, Date, Time, Sample_Location, sample_id, TA_mmolL)
DIC_DOC <- merge(DIC_data1, DOC_data1, by = c("Project", "Date", "Time", "Sample_Location"), all = TRUE)
DIC_DOC_TA <- merge(DIC_DOC, TA_data1, by = c("Project", "Date", "Time", "Sample_Location"), all = TRUE)
DIC_DOC_TA <- DIC_DOC_TA %>%
rename(Time_Local = Time)
meta_2025 <- read.csv("Metadata/FATE_Monitoring_Metadata_2025.csv", colClasses = "character")
meta_2025 <- read.csv("../Metadata/FATE_Monitoring_Metadata_2025.csv", colClasses = "character")
meta_2026 <- read.csv("../Metadata/FATE_Monitoring_Metadata_2026.csv", colClasses = "character")
meta <- bind_rows(meta_2025, meta_2026)
meta1 <- meta %>%
mutate(Date = mdy(Date)) %>%
select(-c(DIC_24ml, DIC_ex_1ml, SO4.H2S_5ml, Nutr_10ml, DOC_20ml, TA_250ml))
all_data <- DIC_DOC_TA %>%
left_join(meta1, by = c("Date", "Time_Local", "Sample_Location"))
final_data <- all_data %>%
select(Project, Date, Time_Local, Sample_Location, sample_id, ic_mgL, ic_mgL_sd, ic_uM, ic_uM_sd, ic_flag, npoc_mgL, npoc_uM, npoc_flag, tdn_mgL, tdn_uM, tdn_flag, TA_mmolL)
colnames(all_data)
View(final_data)
final_data_2023 <- subset(final_data, year(Date) == 2023)
View(final_data_2023)
final_data_2023 <- subset(final_data, year(Date) == 2023)
final_data_2023 <- subset(final_data, year(Date) == 2024)
final_data_2023 <- subset(final_data, year(Date) == 2025)
##Write out annual data files
write.csv(final_data_2023, "FATE_Monitoring_DIC_DOC_2023.csv", row.names = FALSE)
write.csv(final_data_2024, "FATE_Monitoring_DIC_DOC_2024.csv", row.names = FALSE)
final_data_2023 <- subset(final_data, year(Date) == 2023)
final_data_2024 <- subset(final_data, year(Date) == 2024)
final_data_2025 <- subset(final_data, year(Date) == 2025)
##Write out annual data files
write.csv(final_data_2023, "FATE_Monitoring_DIC_DOC_2023.csv", row.names = FALSE)
write.csv(final_data_2024, "FATE_Monitoring_DIC_DOC_2024.csv", row.names = FALSE)
write.csv(final_data_2025, "FATE_Monitoring_DIC_DOC_2025.csv", row.names = FALSE)
colnames(final_data)
#pull the column names from the all_dat1 dataframe and create a new dataframe with them
dd <- data.frame(Column_Names = c(colnames(final_data)))
dd
colnames(final_data)
View(DOC_data)
View(DIC_data)
View(DIC_DOC_TA)
#write out the data dictionary associated with the data:
write.csv(dd, "dd.csv", row.names = FALSE,  fileEncoding = "UTF-8")
colnames(final_data)
