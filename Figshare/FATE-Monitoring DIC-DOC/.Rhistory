#Create a text file that has the description of the data - This ideally should match the text that is in the data READ.ME
datadescription <- "These data are measurements of dissolved inorganic carbon, dissolved organic carbon, and total dissolved nitrogen concentrations in samples collected from tidal creek surface waters as part of the FATE project conducted at the Smithsonian Environmental Research Center's Global Change Research Wetland (GCReW) in the Kirkpatrick Marsh along the Rhode River in Edgewater, MD, USA. Samples were collected roughly bi-weekly throughout 2025. Surface waters of the GCReW tidal creek were collected at the GCReW Flume (38.87486, -76.5465). Samples were collected with a bucket and filtered immediately with 0.45 um syringe filters into combusted glass vials and kept on ice during transport to fridge or freezer. Dissolved inorganic carbon samples were collected with no headspace in combusted 24mL vials with septa caps and refridgerated until analysis. Dissolved inorganic carbon concentrations were determined with a Shimadzu TOC using the manufacturers IC method within one week of collection with a bicarbonate and carbonate standard curve and certified seawater reference material (CRM) from the Scripps Institution of Oceanography of the University of California, San Diego. Dissolved organic carbon and total nitrogen samples were collected in combusted, amber 40mL vials and frozen until analysis. Cocnentrations of non-purgeable organic carbon and total nitrogen were determined with a Shimadzu TOC using the manufacturers NPOC/TN methodolgy with potassium hydrogen phthalate (KHP) and potassium nitrate standard curves."
#write to a text file
writeLines(datadescription, "DataDescription.txt")
#Create a text file that has the description of the data - This ideally should match the text that is in the data READ.ME
keywords <- c("Lateral Flux",
"Tidal Creek",
"FATE",
"Monitoring",
"Carbon",
"GCReW",
"Dissolved Inorganic Carbon",
"Dissolved Organic Carbon",
"Coastal Wetland")
#write to a text file
writeLines(keywords, "KeyWords.txt")
#Pull in the common synoptic authors list:
authors_common <- read.csv(here("Figshare/", "SERC_LateralFlux_common_author_list.csv"))
#create a list of the last names you want to pull
names_we_want <- c("Wilson", "Miller","Muirhead","Read", "Reynolds", "Tamborski", "Megonigal")
order_of_authors <- c(1:length(names_we_want))
authors <- data.frame(
order_of_authors = unlist(order_of_authors),
last_name = unlist(names_we_want)
)
#Subset the common list for the names that we want
author_list <- authors %>%
left_join(authors_common, by = "last_name")
#if you need to add any other authors
others <- data.frame(
first_name = c("first_name1", "first_name2"),
last_name = c("last_name1", "last_name2"),
orcid = c("orcid_id1", "orcid_id2"),
affiliation = c("affiliation1", "affiliation2"),
email = c("email1", "email2"),
order_of_authors = c((length(names_we_want)+1):(length(names_we_want)+2))
)
#add in the other authors
#author_list <- bind_rows(author_list, others)
#write out the author list associated with the data:
write.csv(author_list, "AuthorList.csv", row.names = FALSE)
